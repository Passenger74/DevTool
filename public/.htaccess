# ==============================================================================
# TaskFlow v2.0 - Configuración Apache para SPA
# Compatible con Apache 2.4+ (cPanel moderno)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROTECCIÓN DE ARCHIVOS SENSIBLES
# ------------------------------------------------------------------------------
<FilesMatch "\.(env|git|gitignore|log|sh|ps1|md|json|lock|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloquear acceso a package.json y archivos de configuración
<Files "package.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# ------------------------------------------------------------------------------
# 2. REWRITE RULES - SPA Routing (CORREGIDO)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # [OPCIONAL] Forzar HTTPS - descomentar si tienes SSL activo
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # [OPCIONAL] Forzar non-www - descomentar si es necesario
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # Servir archivos gzip/brotli pre-comprimidos si existen
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}\.gz -f
  RewriteRule ^(.*)$ $1.gz [L]

  # Servir archivos CSS/JS/HTML con extensión correcta
  RewriteCond %{REQUEST_URI} "!\.(css|js|html|json|xml|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot)$"

  # CORRECCIÓN: Evitar loop infinito verificando que no sea index.html
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteCond %{REQUEST_URI} !^/assets/

  # Si el archivo o directorio existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirigir todo lo demás a index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. MIME TYPES - Asegurar tipos correctos
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  # JavaScript
  AddType application/javascript js mjs
  AddType text/javascript js mjs

  # CSS
  AddType text/css css

  # JSON
  AddType application/json json map

  # Web Fonts
  AddType font/woff2 woff2
  AddType font/woff woff
  AddType font/ttf ttf
  AddType font/otf otf
  AddType application/vnd.ms-fontobject eot

  # Imágenes
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType image/x-icon ico

  # Manifest
  AddType application/manifest+json webmanifest
</IfModule>

# ------------------------------------------------------------------------------
# 4. CACHE CONTROL - Optimizado para Vite (hash en filenames)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML - No cachear (siempre verificar actualización)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS y JS - Cache largo (Vite genera hashes únicos)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Imágenes
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fuentes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Otros
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

# Cache-Control headers específicos (más granular que mod_expires)
<IfModule mod_headers.c>
  # Assets con hash (Vite) - Cache immutable
  <FilesMatch "\.(js|css|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML - No cachear, siempre revalidar
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Imágenes y fuentes - Cache largo
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # JSON y datos - No cachear
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 5. COMPRESSION - GZIP/Brotli
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  # Comprimir tipos de texto y código
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/truetype
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/javascript

  # Excluir archivos ya comprimidos
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|zip|gz|br|woff2?)$ no-gzip dont-vary
</IfModule>

# ------------------------------------------------------------------------------
# 6. SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevenir MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Protección contra clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Protección XSS (legacy, pero aún útil)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy (reemplaza Feature-Policy)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # Eliminar headers que revelan información del servidor
  Header always unset X-Powered-By
  Header always unset Server
  Header always unset X-AspNet-Version
  Header always unset X-AspNetMvc-Version

  # CORS para fuentes (necesario para Google Fonts y fuentes locales)
  <FilesMatch "\.(woff2|woff|ttf|eot|otf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 7. ERROR PAGES - Manejo correcto para SPA
# ------------------------------------------------------------------------------
# CORRECCIÓN: Usar solo 404 → index.html para SPA routing
# NO redirigir 403 ni 500 a index.html (oculta errores reales)
<IfModule mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

# ------------------------------------------------------------------------------
# 8. MISCELLANEOUS
# ------------------------------------------------------------------------------

# Charset por defecto
AddDefaultCharset UTF-8

# ETags optimizados
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# Deshabilitar listado de directorios (con protección)
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Limitar tamaño de uploads (ajustar según necesidades)
LimitRequestBody 10485760

# Timeout de conexión
<IfModule mod_reqtimeout.c>
  RequestReadTimeout header=20-40,MinRate=500 body=20,MinRate=500
</IfModule>

# ==============================================================================
# FIN DE CONFIGURACIÓN
# ==============================================================================
