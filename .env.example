# Ajusta estos valores en tu entorno local. NUNCA comites un .env con valores reales.
# Para conectar a Supabase: copia aquí la connection string que encuentras en
# Supabase -> Project -> Settings -> Database -> Connection string
# Ejemplo de formato (incluye sslmode=require que Supabase necesita):
# postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?schema=public&sslmode=require

# Cadena de conexión para Prisma (Postgres). Reemplaza por la tuya propia.
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public&sslmode=require"

# JWT secret usado por el backend (no lo comites)
JWT_SECRET="cambia_esto_por_un_secreto_largo"

# Parámetros opcionales
BCRYPT_SALT_ROUNDS=10
NODE_ENV=development
